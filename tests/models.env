# Checkpoints the tests, benches and gate.sh load, one variable per role: a directory name under $ENGINE_MODEL_ROOT, or an absolute path.
# tests/local.env (not committed) overrides any of them for one machine, and so does the process environment; test_paths.h reads the same
# files when a test is started by hand. GATE_BUILD is the build directory gate.sh runs from: build_vl when the EXL3 checkpoints are in the Volta tile order.
ENGINE_TEST_QWEN_DIR=Qwen3.8-27B-exl3
ENGINE_TEST_DRAFT_DIR=Qwen3.8-27B-DFlash2-EXL3-5.0bpw
ENGINE_TEST_QWEN_DRAFT_BF16_DIR=Qwen3.8-27B-DFlash2
ENGINE_TEST_QWEN_NVFP4_DIR=Qwen3.8-27B-QUASAR-NVFP4
ENGINE_TEST_GLM_DIR=GLM-5.3-Flash-exl3-3.05bpw
ENGINE_TEST_GLM_DRAFT_DIR=GLM-5.3-Flash-DFlash2
ENGINE_TEST_GLM_NVFP4_DIR=GLM-5.3-Flash-NVFP4
ENGINE_TEST_GLM_NVFP4_DENSE_DIR=GLM-5.3-Flash-NVFP4-dense
ENGINE_TEST_FLASH_DIR=Swift-Qwen3.8-Flash-Next-exl3-4.00bpw
ENGINE_TEST_DSV41_DIR=DeepSeek-V4.1-Flash-1017-exl3-1.68bpw
GATE_BUILD=build
