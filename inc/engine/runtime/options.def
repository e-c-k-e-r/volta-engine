// Runtime and model options: the single source for the Options struct, the ENGINE_<NAME> environment overrides, the launch
// config "options" object / --set key=value, and docs/CONFIG.md (generated by `volta_server --print-config-docs`).
// OPTION( type, name, default, help )         environment variable ENGINE_<NAME>
// DEBUG_OPTION( type, name, default, help )   environment variable ENGINE_DEBUG_<NAME>
// <0 (or 0 for sizes) means "unset: use the model's default" where a help text says so.

OPTION( std::string, log_level, "info", "log threshold: error, warn, info or debug" )
OPTION( bool, pin_threads, true, "the generator's scheduler thread pinned to CPU 4, beside the cores 0 to 3 the rank threads drive the GPUs from; false: the OS places it (libvolta's default, inside a host application)" )
OPTION( int, tp, -1, "rank count: 1, 2 or 4 (GLM: 1, 2 or 4; the CPU build runs one rank, the Vulkan build one device per rank); <0 uses the launch's tp_size" )
OPTION( int, arena_gib, -1, "per-GPU arena in GiB; <=0 sizes it from the device's free memory minus vram_reserve_mib" )
OPTION( int, vram_reserve_mib, -1, "memory left outside the arena for what the CUDA driver takes after it is sized (kernel code loaded on first use, graph instances); <0: 384" )
OPTION( int, scratch_mib, 256, "arena memory set aside before the model loads for the kernel modules' workspaces (split-K and attention partials, the dequantized weight of the prefill GEMM); a workspace that does not fit comes from the arena's free space, with a warning" )
OPTION( int, max_seq, 0, "context window per slot in tokens (sizes the KV pool); 0 = the model default (Qwen 32768, GLM 12288)" )
OPTION( int, max_slots, 0, "decode slots; 0 = the model default (Qwen 8, GLM 1)" )
OPTION( int, prefix_cache_gib, 16, "pinned host RAM for the prefix cache (sequence snapshots); 0 = off" )
OPTION( std::string, prefix_cache_dir, "", "directory of the prefix cache\'s disk tier: evicted snapshots are written there instead of dropped, all of them when the server stops, and a restart reads them back on demand (files are kept apart per model and configuration); empty = RAM only" )
OPTION( int, prefix_cache_disk_gib, 64, "with prefix_cache_dir: the disk tier\'s size, shared by every model directory under prefix_cache_dir (other checkpoints and option sets, other servers); the least recently used files are deleted beyond it, whichever directory holds them" )
OPTION( int, prefill_window, -1, "GLM and DeepSeek (up to 16): prefill several chunks of a prompt layer by layer: the routed experts of a layer then run once over all the window's rows instead of once per 512-row chunk (and a cold expert is staged once per window); costs about 0.1 GiB of buffers per extra chunk (the KV pool or expert_cache give it back). Taken when a prompt prefills on its own, not beside decoding requests or with a speculator that reads the chunks. -1 = the model's default: 8 on GLM; on DeepSeek as many chunks (up to 4) as the arena holds once every routed expert is resident, else a chunk at a time (decode pays for experts in host memory); 0 or 1 = a chunk at a time" )
OPTION( int, prefill_truncate, -1, "DeepSeek-V4.1: rows of a prefill call (a prompt, or the piece up to a prefix-cache checkpoint) that run the layers from the first one reading the shared compressed KV (layer 20) on; the earlier rows only write that layer's KV, index keys and window entries, and the later layers attend their window from the first kept row on (DeepInfer's YoCo prefill truncation). -1 = exact: 2541 rows (the window plus 127 rows per later layer), the result equals a full prefill up to summation order; a positive count keeps that many (at least the 128-token window; fewer than the exact count is approximate: the kept rows' windows are cut short); 0 = every row runs every layer" )
OPTION( double, prefill_budget_ms, 0.0, "while other requests are decoding, the longest (ms) a prompt piece may run before the decoding requests step again: the piece size adapts between 64 and prefill_chunk rows from the measured piece time (smaller pieces lower the prompt's speed); 0 = pieces of prefill_chunk rows" )
OPTION( int, prefill_cooldown, 0, "while other requests are decoding, the decode steps that run between two prompt pieces (0 = a piece every step): the decoding requests then get most of the GPU time and the prompt is ingested more slowly, in pieces of the same size" )
OPTION( int, prefill_chunk, 512, "prompt tokens a new request prefills per scheduler step while other requests are decoding (decode steps run between the pieces); 0 = the whole prompt at once" )
OPTION( int, prefix_interval, 16384, "prompt tokens between automatic prefix checkpoints inside long prompts; 0 = only the requested ones" )
OPTION( bool, prefix_cache_reply, true, "prefix cache: when a request ends, snapshot everything the slot has read (prompt and reply), so an agent's next request, whose prompt renders the reply back, resumes after it instead of reading the reply again" )
OPTION( std::string, nvfp4_experts, "", "Flash-Next: directory of a modelopt NVFP4 checkpoint (same architecture) to load the routed experts from; everything else comes from the model directory. Empty = the model's own experts (NVFP4 when the model directory is that checkpoint)" )
OPTION( std::string, nvfp4_dense, "", "dense projection groups to quantize to NVFP4 at load (round-to-nearest from the BF16 tensors of the nvfp4_experts checkpoint): Flash-Next: gdn, shared (or shared_gate / shared_up / shared_down), attn, idx, head; GLM: kda, mla, idx, shared, dense, head; Qwen NVFP4 checkpoint: head (a quarter of the bytes of the FP16 head); or all" )
OPTION( std::string, hessian_dir, "", "calibration (Flash-Next, GLM, Qwen3.5-family dense): directory to write the input Hessians (x^T x per dense projection input, fp32) of the prefill rows that ran, one file per site at shutdown; empty = off" )
OPTION( bool, embed_host, true, "Qwen3.8-27B, Flash-Next: keep the embedding table in pinned host memory, one copy shared by every rank and read over the link a few rows per forward, instead of a BF16 copy in every GPU's arena (2.37 GiB per GPU on the 27B, 1.18 GiB on Flash-Next); GLM and DeepSeek always do; false: the per-GPU copy" )
OPTION( bool, mtp_nvfp4, false, "Flash-Next: load the MTP head from the nvfp4_experts checkpoint instead of the model directory (its FP8 block-scaled experts and BF16 dense tensors are quantized to NVFP4 at load; the head then matches the base model, not the model directory's conversion). Implied when the model directory is the NVFP4 checkpoint" )
OPTION( std::string, nvfp4_dense_dir, "", "Flash-Next, GLM: directory of calibrated NVFP4 dense tensors (volta_nvfp4) used instead of round-to-nearest for the groups of nvfp4_dense they cover" )
OPTION( std::string, mtp_head_dir, "", "Flash-Next with speculator=mtp: directory of a modelopt NVFP4 checkpoint to take the MTP head from while the model's own weights, routed experts included, stay as they are (a GGUF conversion's MTP block lacks its connectors; the head then matches the base model, not the conversion). Its FP8 block-scaled experts and BF16 dense tensors are quantized to NVFP4 at load. Empty = the head comes from the model directory, or from nvfp4_experts with mtp_nvfp4" )
OPTION( std::string, nvfp4_dense_src, "", "directory of a modelopt NVFP4 checkpoint of the model whose BF16 dense tensors the nvfp4_dense groups are quantized from (GLM; Flash-Next takes them from nvfp4_experts)" )
OPTION( std::string, nvfp4_expert_layers, "", "GLM, with nvfp4_dense_src: layers \"lo-hi\" whose routed experts load from that modelopt NVFP4 checkpoint instead of the model directory (those layers stay out of the expert tier, always resident); empty = none" )
OPTION( std::string, dflash_hessian_dir, "", "calibration of the DFlash2 drafter: directory to write the input Hessians of its projections (L<layer>_s<site>_r<rank>.f32: site 0 q_proj, 1 k_proj / v_proj (context rows and block rows), 2 o_proj (one file per rank), 3 gate_proj / up_proj, 4 down_proj (per rank); layer 5 site 0 = fc) over the rows the drafter processes while the server speculates, written when the speculator shuts down; empty = off" )
OPTION( std::string, hessian_layers, "", "with hessian_dir: layers to collect, \"lo-hi\" (GLM: the accumulators of all 45 layers do not fit beside the weights, so collect a third at a time); empty = all" )
OPTION( int, sparse_head, 0, "MTP speculation (Flash-Next, Qwen3.8-27B): columns of the sparse drafter head, an FP16 copy of the LM-head columns of the most frequent tokens that the draft steps use instead of the full head (verification keeps the full head, so the output is unchanged); 0 = off" )
OPTION( int, sparse_head_interval, 2048, "with sparse_head: generated tokens between rebuilds of the subset (the most frequent tokens so far; an incumbent keeps its place unless a challenger is 25% more frequent, and a rebuild that would change under 2% of it is skipped); a rebuild reads the columns through about 20 passes of the full head" )
OPTION( std::string, sparse_head_file, "", "with sparse_head: file the token counts behind the subset are read from at start and saved to every 4096 generated tokens and at exit, so a new session starts from the last one's subset instead of building it from scratch (counts belong to the tokenizer: one file per model family)" )
OPTION( std::string, loop_detect, "off", "stop runaway repetition: off, report (log a warning when a request's output settles into repeating the same span, exactly or nearly) or stop (also end the request: finish reason stop / end_turn, counted as loop in /api/stats). Detection follows exllamav3's LoopDetector: exact repetition after 4 copies and 1024 tokens, near repetition after 8 copies and 8192 tokens, answer options transcribed from the prompt exempt. A request's stop_on_loop field (true / false) overrides it" )
OPTION( std::string, kv_format, "", "KV cache format: fp16, fp8, k8v4 or nvfp4; empty = the model default (fp16). GLM stores its single latent tensor in one format (k8v4 = 8-bit); DeepSeek-V4.1 ignores it (its caches keep the checkpoint's FP8 / FP4 codes)" )
OPTION( int, kv_pool, 0, "GLM: tokens of one shared KV pool for all slots (latent cache and indexer keys, in pages of 512 tokens); 0 = every slot owns max_seq tokens. With 2 slots of 256K, 262144 holds one long and one short conversation, or two of 128K, in half the memory; a request is admitted when the pool has room for its prompt and ends with finish reason length when the pool runs out" )
OPTION( bool, kv_shard, false, "GLM with kv_pool on 2 or 4 GPUs: each GPU keeps the latent cache of every tp-th page of a slot (page p on rank p % tp) instead of all of it, and the attention reads a page from the GPU that holds it (peer access over NVLink); a quarter of the latent cache per GPU at tp 4. The indexer's pooled keys are spread the same way: a GPU scores its own pages and the GPUs' best pools are merged into the same selection. CUDA only" )
OPTION( double, expert_cache, 1.0, "resident routed-expert fraction in (0, 1] (GLM, Flash-Next), or auto (GLM only): the largest fraction the arena holds after the other weights, the speculator and a 0.25 GiB margin (the log prints the plan); below 1 enables the two-tier expert cache: the codes of the cold experts live in pinned host memory and are read over PCIe" )
OPTION( int, expert_stage, -1, "expert tier, prefill chunks: copy a layer's cold experts once into device scratch, a layer ahead of the compute, instead of reading them over PCIe from every row tile (needs 2 x the cold experts of a layer in the arena, 1 x with expert_stream, which copies a layer once it has been read; off when it does not fit). -1 auto: on, except for Flash-Next's trellis experts (staging does not pay for them); 0 off; 1 on" )
OPTION( bool, tile_gains, true, "EXL3 extended trellis (volta_quantize --tile-gain): load the routed experts' per-tile gains; false leaves them on disk and the tiles decode at gain 1 (a byte per 16 x 16 tile less in the arena, the experts' tile starts still load)" )
OPTION( int, expert_adapt_every, 64, "decode steps between expert residency rebalances (0 = never)" )
OPTION( double, route_resident_bias, 0.0, "with expert_cache < 1 (GLM): added to the router selection score of every expert resident on the device, for every row (prompt and generated), so near-ties go to resident experts and fewer cold experts are read over PCIe; the weights stay the raw scores of the chosen experts. Units of GLM's selection score (sigmoid plus the correction bias, about 0 to 1); 0 = off. Follows the residency after every rebalance" )
OPTION( int, expert_swap_margin, 2, "a cold expert replaces the coldest resident one only when its decayed route score exceeds 1.5 x the resident one's plus this margin (scores are route counts per rebalance window, folded as score / 2 + count); lower values adapt faster and flip more" )
OPTION( int, expert_history_pct, 75, "the largest share (percent) of a swap decision taken from a layer's long-run route counts (saved between runs with expert_heat_file) instead of the last windows; it grows with the amount of history, so a cold start follows the first windows; 0 = windows only" )
OPTION( int, expert_swaps, -1, "maximum expert swaps per layer per rebalance; <0 = derived from expert_swap_mib" )
OPTION( int, expert_swap_mib, 1024, "bytes the swaps of one rebalance pass may move (MiB; a swap moves two experts), spread over the layers, when expert_swaps is not set" )
OPTION( int, expert_shard, -1, "DeepSeek on several GPUs: every rank holds a slice (a share of the intermediate width, in 128-wide spans, 256-wide for GGUF blocks, the larger shares rotating with the expert) of every routed expert instead of whole experts dealt to the ranks, so the ranks no longer wait for the one that drew the most routes. -1 (auto): on for GGUF experts, whose kernels cost about the same per byte at any slice width; off for EXL3 packs, whose fused kernels cost per expert, so the narrow slices make decode slower. 0 off; 1 on" )
OPTION( std::string, expert_heat_file, "", "file the tiered experts' per-layer route counts are saved to (every few rebalances and at exit) and read from at start: the resident sets then start with the hottest experts instead of experts 0..N-1 (one file per rank: .r<rank> is appended with more than one rank). DeepSeek-V4.1: counts saved at exit; at start the experts are dealt to the ranks by heat and the hottest stay on the device" )
OPTION( double, cpu_experts, 0.0, "with expert_cache < 1 (GLM, Flash-Next): decode hands this share (0 to 1, rounded down) of a layer's distinct cold experts to the host CPU while the GPU reads the rest over PCIe, so the two work at the same time; a lone cold expert stays on PCIe. NVFP4 experts are read in place from the pinned copy the GPU uses (plus a copy of their scales, 1/8 of the codes); EXL3 experts get a second, repacked copy in host RAM and the CPU does not beat PCIe on them in single-row decode" )
OPTION( std::string, cpu_expert_cpus, "", "with cpu_experts: the logical CPUs of the expert threads, e.g. 10-19 (the first runs the dispatcher and takes part in the work; all are pinned); keep clear of the cores 0 to 3 that drive the GPUs (one per rank); empty = one thread per physical core of cpu_expert_node, or by default: EXL3 experts (compute-bound) on the last NUMA node, with a second pool on node 0 when there are two (each expert's output columns are split between them), NVFP4 experts (read in place from the pinned codes on node 0) on node 0; cores 0 to 3 of node 0 are left to the rank threads" )
OPTION( int, cpu_expert_node, -1, "with cpu_experts: NUMA node the CPU-side copies (NVFP4 scales, repacked EXL3 codes) are bound to; the cold experts' pinned codes sit on the node of the rank threads (node 0). <0 = the node of the expert threads when cpu_expert_cpus is unset (the last node), otherwise not bound" )
OPTION( int, cpu_expert_spin_us, 2000, "with cpu_experts: microseconds the expert threads keep polling for work after the last request before they sleep; a sleeping core costs a wake-up and a clock ramp (up to a few hundred microseconds) on the next layer that needs it, polling keeps the cores busy (hotter, louder)" )
OPTION( std::string, steer, "off", "runtime steering of the residual stream per request (control vectors) and the reasoning-marker logit penalty: off (nothing allocated, no kernels), on (requests opt in with their steer fields) or file (every request gets steer_file unless it says otherwise). Qwen3.5-family dense models, Flash-Next, GLM and DeepSeek" )
OPTION( std::string, steer_layers, "", "steered layers, first-last: indices, fractions of the layer count (0.33, 1/3) or last; empty = 1/3-2/3 (the memory per slot grows with the count)" )
OPTION( std::string, steer_file, "", "control-vector file (steer_build) of steer=file and of requests that ask for the steering file without naming one" )
OPTION( std::string, steer_dir, "", "directory of control-vector files that requests name with steer_vector (the name plus .steer); empty = requests cannot name files" )
OPTION( std::string, probe, "", "with steer: comma list of probe files (steer_build --probe) in steer_dir scored on every request that names none itself, at most 4; each request\'s usage reports the scores at its last prompt token and over its output" )
OPTION( std::string, low_priority_models, "haiku", "comma list of substrings of the requested model name (case-insensitive) whose requests queue behind the others (priority 1 instead of 0) when they wait for a slot; a request\'s own priority field wins; empty = all equal" )
OPTION( double, steer_scale, 1.0, "multiplies the strengths of the add entries of control-vector files (a request's steer_scale replaces it)" )
OPTION( std::string, steer_scope, "", "rows a control-vector file edits, a comma list of prompt, think, answer, generated, all; empty = the file's own scope" )
OPTION( std::string, steer_gate_threshold, "auto", "requests with steer_probe: the look-ahead score above which the probe's direction clamp is applied (0 = like the accepting openings, 1 = like the declining ones); auto = the model's value (inc/engine/models/steer_defaults.h)" )
OPTION( std::string, steer_edit_strength, "auto", "requests with steer_probe: the first clamp's reference level sits this many standard deviations (of the accepting openings' projections) below their mean projection; more negative values leave more of the projection in place and degrade the text less, higher values remove more; auto = the model's value" )
OPTION( double, steer_hedge_strength, -1.0, "requests with steer_probe: a second clamp (plain against hedged openings) removes the part of the projection beyond this fraction of the gap above the plain mean; < 0 = off; it degrades the text quickly" )
OPTION( std::string, steer_openings, "", "requests with steer_probe: a file that replaces the built-in forced openings (lines `accept: TEXT`, `decline: TEXT`, `plain: TEXT`, `hedged: TEXT`; a kind with no line keeps the built-in ones). More and more varied openings give the probe's directions more to average over" )
OPTION( int, steer_directions, 1, "requests with steer_probe: clamp this many refusal directions per edit layer (1 to 4; the first is the openings' mean difference, the rest the strongest remaining variation of the declining openings after it and the accepting spread are removed). Edit slots per layer are shared with steer_push and the hedge clamp" )
OPTION( bool, steer_keep_norm, false, "requests with steer_probe: after a clamp removed something, rescale the row to the norm it had before" )
OPTION( double, steer_push, 0.0, "requests with steer_probe: add the probe's declining direction to the states of the edit layers, this many times the gap between the accepting and the declining openings (their mean projections), whether or not the gate fires; 0 = off. Positive pushes towards declining, negative away from it" )
OPTION( std::string, steer_band, "", "requests with steer_probe: layers whose states the probe reads, first-last as steer_layers; empty = 1/3-2/3 of the layers" )
OPTION( std::string, steer_edit_layers, "", "requests with steer_probe: layers the clamps edit (inside steer_layers and steer_band), first-last as steer_layers; empty = the model's window (inc/engine/models/steer_defaults.h; a wider one degrades unrelated text)" )
OPTION( int, thinking_budget, 0, "reasoning budget of requests that turn thinking on without one (Anthropic adaptive thinking, an effort alone), at most half the request's max_tokens so the reply keeps room for its answer; -1 = half of max_tokens; 0 = unlimited. A request's own budget_tokens is kept" )
OPTION( int, thinking_soft_close, 128, "a request's reasoning budget (thinking budget_tokens): once it runs out, the reasoning block closes after the next token that ends a sentence (., ! or ?, not a . after a digit) or a line, at most this many tokens later (the slot decodes one token a step meanwhile, so the close lands right there); 0 = close exactly at the budget" )
OPTION( double, think_penalty, 0.0, "logit subtracted from the first tokens of reflection markers (think_penalty_words) while the model is inside its reasoning block, for every request (a request's think_penalty replaces it); needs steer != off; 0 = off" )
OPTION( std::string, think_penalty_words, "", "words of think_penalty: a comma list or a file of one word per line; empty = Wait, Hmm, Alternatively, But (with the space-prefixed and lower-case variants)" )
OPTION( std::string, speculator, "dflash", "speculation source: dflash (needs a draft model), mtp (the checkpoint's own multi-token-prediction head: Qwen, Flash-Next, GLM), suffix (no model: the text that followed the last earlier occurrence of the request's current suffix, spec_suffix > 0; DeepSeek) or dspark (DeepSeek: the block drafter in draft_model_dir, see dspark_conf)" )
DEBUG_OPTION( int, exl3_gemv_max_m, 4, "ROCm: EXL3 linears of up to this many rows (0 to 8) run the v_dot2 GEMV; the rows above it, up to exl3_wmma_max_m, run the WMMA GEMM (for A/B)" )
DEBUG_OPTION( int, exl3_wmma_max_m, 64, "ROCm: EXL3 linears of 9 up to this many rows (at most 64) run the WMMA GEMM that reads the packed weight once; more rows, or 0 here, dequantize the weight and call hipBLAS (for A/B)" )
DEBUG_OPTION( int, glm_layers, 0, "GLM: run only the first N decoder layers (a checkpoint cut to N layers, for A/B of kernels on a small model; the logits mean nothing); 0 = all 45" )
DEBUG_OPTION( int, gemv_max_rows, 16, "EXL3 projections: the most rows the GEMV takes before the GEMM tile (9 to 16: the Volta tile order, and the stock order on inputs up to 2560 wide); 8 = the GEMM from 9 rows (A/B)" )
DEBUG_OPTION( bool, gemv_int8, true, "EXL3 projections of 1 and 2 rows: the dp4a int8 GEMV first; false = the tensor-core GEMV (A/B)" )
DEBUG_OPTION( bool, gguf_mma, true, "CUDA GGUF projections: the tensor-core rows kernel for 9 to 16 rows (Q4_K / Q6_K from 6 / 8 rows); false = the GEMV and tile paths (A/B)" )
DEBUG_OPTION( int, gguf_gemv_warp, -1, "CUDA GGUF projections of up to 8 rows: 1 = a warp per weight row, 0 = a block of four warps per row; -1 = a warp per row when the row is shorter than one pass of the block (Q5_K: 2048 values, Q8_0: 1024) (A/B)" )
DEBUG_OPTION( bool, ar_ll, true, "CUDA IPC all-reduces of decode rows (up to 16): every rank writes its rows into its peers' memory as LL lines (a sequence flag beside every 4 data bytes) and spins on its own memory, with no fence, flag or read across the link; false: the staged pull (A/B)" )
DEBUG_OPTION( bool, dflash_attn_scalar, false, "DFlash2 drafter attention on CUDA: the scalar one-block-per-(row, head) kernel instead of the split-key kernel (for A/B)" )
DEBUG_OPTION( bool, spec_profile, false, "DFlash2: time the stages of every round (draft, walk, snapshot switch, verify launch, sample wait, accept) and log the per-round averages when the server shuts down" )
DEBUG_OPTION( bool, merge_expert_groups, true, "DeepSeek-V4.1 packs whose experts have different widths per projection: one MoE launch per layer over all of a rank's experts with a width table (false: one launch per width combination, for A/B)" )
DEBUG_OPTION( bool, fp8_resident, true, "DeepSeek-V4.1 packs that keep the original FP8 attention and shared-expert weights (SAGE): keep them FP8 in device memory (false: dequantize to FP16 at load, twice the bytes)" )
DEBUG_OPTION( bool, indexer_tc, true, "DeepSeek-V4.1: the indexer scores prefill rows on tensor cores (false: the scalar kernel, for A/B)" )
OPTION( double, dspark_conf, 0.5, "speculator=dspark: a draft token is verified only while the drafter's confidence head scores it and every earlier token of the block at least this (0 = always the whole block)" )
OPTION( int, mtp_depth, 7, "most draft tokens per round with speculator=mtp (1 to 7); the head stops chaining earlier when its recent accuracy is low" )
OPTION( bool, draft_tp, true, "the DFlash drafter on every rank: each keeps its share of every position's taps (the drafter's fc is row-parallel over them; whole taps where a share would split a 128-wide block, and with dflash_hessian_dir) and the selector codebook rows of its vocabulary shard; false runs it on rank 0 only, every rank keeping whole taps and rank 0 the codebooks" )
OPTION( bool, dsa, true, "GLM sparse attention indexer (top-2048 key selection); false attends densely" )
OPTION( int, vision_cpu, 0, "image input on the host CPU instead of the GPUs: the largest image the tower accepts, in language-model tokens (what max_image_tokens is for the GPU tower, which then stays 0 so no tower weights or scratch take VRAM). The tower's projections are decoded once into FP16 in host memory (GLM-5: about 1.7 GiB) and run on vision_cpus; a request with images encodes them on its own thread while the slots keep decoding (a 576-token screenshot: tens of seconds on a few capped cores; repeats come from the embedding cache). GLM-5 and DeepSeek-V4.1; 0 = off" )
OPTION( std::string, vision_cpus, "", "with vision_cpu: the logical CPUs of the encoder threads, e.g. 10-19 (the first is the request thread's while it encodes, all are pinned); keep clear of the cores 0 to 3 that drive the GPUs; empty = one thread per physical core of the last NUMA node" )
OPTION( std::string, vision_mmproj, "", "with vision_cpu: a directory holding the model's vision projector GGUF (a file named *mmproj*.gguf: llama.cpp's mmproj, BF16 weights) to take the tower's weights from, instead of the EXL3 tensors of vision_dir (the config.json and processor_config.json still come from vision_dir, or model_dir). GLM-5 and DeepSeek-V4.1" )
OPTION( std::string, vision_dir, "", "with vision_cpu: the checkpoint that holds the vision tower (its config.json, processor_config.json and model.visual.* tensors), e.g. the EXL3 one of the model whose GGUF is served; empty = model_dir" )
OPTION( int, max_image_tokens, 1024, "largest image the vision tower accepts, in language-model tokens (4 patches each, 9 for DeepSeek, whose count also includes the span's delimiter and newline tokens; sizes its scratch and caps the resize); 0 = image input off. DeepSeek keeps the tower's 0.9 GiB plus scratch out of rank 0's resident experts: its shipped config sets 576, the gate and the benchmarks pass 0" )
OPTION( int, max_video_tokens, 8192, "most language-model tokens a video takes (Qwen3-VL and GLM-5 checkpoints with a video processor): its frames shrink to fit, then evenly spaced frames drop; each step (two frames) is also held to max_image_tokens (or vision_cpu); 0 = video input off" )
OPTION( int, max_audio_seconds, 300, "longest audio input in seconds (Gemma 4's small models: 25 language-model tokens a second, the tower encoding 30-second chunks); 0 = audio input off, and no audio tower loads" )
OPTION( bool, expert_stats, true, "count the routes per expert for the monitor page (a device sync per rank about once a second while serving)" )
DEBUG_OPTION( std::string, spec_block_cycle, "", "DFlash2: block sizes the rounds cycle through, e.g. 7,1 (timing experiments); empty = the depth policy decides" )
OPTION( bool, spec_depth_rate, false, "DFlash2: choose each round's block size for the most expected tokens per millisecond: the drafter's recent per-position accuracy gives the expected accepted tokens of each size, the measured round times (draft and verify, fitted as a fixed and a per-row cost) give its time; replaces spec_depth while on" )
OPTION( double, spec_depth, 0.0, "DFlash2: shorten each round's block where the drafter's recent per-position accuracy says the chance of reaching a position is below this (0 = always the whole block; typically 0.15 to 0.3)" )
OPTION( int, spec_suffix_min, 3, "with spec_suffix: the fewest continuation tokens a match must offer to be used instead of drafting (1 to 7)" )
OPTION( int, spec_suffix, 0, "DFlash2, MTP, DSpark, speculator=suffix: propose the tokens that followed the last earlier occurrence of the current suffix of this request's prompt and output (copied text: file contents, tool arguments, identifiers) instead of drafting when that suffix matches at least this many tokens; 0 = always draft" )
OPTION( bool, spec_ctrl, true, "adaptive speculation controller; false always speculates" )
OPTION( int, moe_heavy_rows, 0, "trellis MoE prefill: an expert routed by at least this many rows of a chunk (or prefill window) runs as FP16 dequantization + a tensor-core GEMM instead of the quantized kernel (pays mostly with prefill_window; 256 with a window of 8 on GLM). Its rounding differs from the quantized kernel's, so prefills of the same text cut into different chunks no longer give identical logits; 0 = off" )
DEBUG_OPTION( int, moe_coop_mode, -1, "fused decode MoE: the expert tile path; -1 = by row count, width and tile order, 0 = tensor core, 1 = int8 dp4a one row at a time, 2 = int8 any width (3-bit experts; others take 3), 3 = int8 for runs of up to 4 rows and the tensor core above (A/B)" )
DEBUG_OPTION( bool, gdn_chunked, true, "Linear attention (Qwen3.5 / Flash-Next GDN, GLM KDA), prefill chunks of more than 16 rows: the chunked delta rule (64-row chunks on the tensor cores); false steps the rows one at a time as decoding does (A/B)" )
DEBUG_OPTION( bool, moe_prefill_tile, true, "trellis MoE, prefill chunks of more than 128 rows: the 32-row expert tile with two resident blocks per SM; false runs the 16-row tile of the decode kernels (A/B)" )
DEBUG_OPTION( bool, gguf_q8r, true, "CUDA GGUF: dense Q8_0 weights repacked at load into aligned runs of values and scales (Q8_0R) for a dp4a GEMV of up to 16 rows; false keeps the file layout and llama.cpp's kernels (A/B)" )
DEBUG_OPTION( bool, gguf_moe_tile, true, "GGUF routed experts: prefill chunks decode each expert's weight tiles to FP16 once per pass and multiply all their routes on the tensor cores; false keeps the route-by-route vec_dot path (A/B)" )
DEBUG_OPTION( bool, gguf_moe_tile884, true, "GGUF routed experts on compute capability 7.0: the tile path's IQ1 / IQ2 / Q2_K weights decode straight into the m8n8k4 tensor-core operands instead of a decoded tile in shared memory; false keeps the WMMA tile (A/B)" )
DEBUG_OPTION( bool, shared_slice, true, "GLM and DeepSeek-V4.1: the shared expert is cut over the ranks (each holds and runs 1/tp of its width, the partial outputs meet in the MoE all-reduce), and so is GLM's dense MLP of layers 0-2 (an all-reduce after its down projection); false runs the shared expert whole on rank 0 (GLM loads it on every rank) and GLM's dense MLP whole on every rank (A/B)" )
DEBUG_OPTION( bool, moe_gemv, false, "ROCm: the expert-grouped EXL3 MoE runs its projections on the v_dot2 GEMV instead of the WMMA kernels" )
DEBUG_OPTION( bool, nvfp4_hipblas, false, "ROCm: NVFP4 linears of more than 16 rows dequantize into FP16 and run one hipBLAS GEMM instead of the fused WMMA GEMM (the FP16 scratch can move as it grows, which a captured graph cannot follow)" )
DEBUG_OPTION( bool, ple_log, false, "Flash-Next: time the per-forward n-gram (PLE) lookup on rank 0 (host lookup and decode, the rank barriers, the upload and its sync) against the time between forwards, printed for every 256 forwards of a row-count class" )
DEBUG_OPTION( bool, expert_log, false, "per-rebalance expert tier statistics" )
DEBUG_OPTION( int, glm_logit_rows, 0, "GLM: rows of logits a forward can keep; <= 0 = one decode batch (16). Scoring tools (test_ppl) that read the logits of every row of a prefill chunk need the chunk size here (rows x vocabulary x 2 bytes, twice)" )
DEBUG_OPTION( bool, expert_stream, false, "for checkpoints larger than host RAM (needs expert_cache < 1, GLM): the cold experts live in the checkpoint and are read (parallel pread, NVMe speed) into one pinned layer-sized buffer before each layer's MoE, then read in place as usual; eager forwards only (no graphs), prefill speed is the disk's" )
DEBUG_OPTION( int, expert_stream_host_gib, 0, "with expert_stream: GiB of pinned host memory per rank that keep as many of every layer's cold experts in RAM for the whole run (read at load); only the others are streamed from the checkpoint before each layer. 0 = every cold expert streamed" )
DEBUG_OPTION( int, expert_synth, 0, "timing only, outputs are wrong. 1: the cold experts of the expert tier alias the device slots of resident ones (no host memory, no PCIe reads, no rebalancing), to time the kernels apart from the link. 2: also no expert tensor is read from the checkpoint (a copy made without them works): the resident slots are generated, with expert_cache < 1 (trellis experts, one rank)" )
DEBUG_OPTION( bool, dsa_diag, false, "sparse-attention indexer diagnostics" )
DEBUG_OPTION( std::string, trace_layers, "", "GLM, Flash-Next: file that receives the last row's residual streams after every layer of every eager forward (rank 0)" )
DEBUG_OPTION( bool, trace_device, false, "Flash-Next, with trace_layers: the records copied on the device as the forward runs (every row of the first four layers, the PLE layer and the output; the last row elsewhere) and written at its end, so the forward runs without a host sync in between; every rank records, rank r > 0 into <trace_layers>.r<r>" )
DEBUG_OPTION( bool, sparse_head_force, false, "with sparse_head: draft through the subset whenever one exists, whatever the miss rate (measures the sparse head's raw effect on draft time and acceptance)" )
DEBUG_OPTION( std::string, route_dump, "", "Flash-Next, GLM: file that receives, for every MoE layer of every eager prefill chunk (rank 0), the router input rows (FP16) and the routed expert ids, to measure how well a layer's routing can be predicted from the layer before it (offline), and to <file>.w the routing weights (FP32, rows x top_k per record, the same order) for routing-weighted expert Hessians (volta_quantize --affinity-eps)" )
DEBUG_OPTION( std::string, train_inputs, "", "Flash-Next: file that receives, for every eager forward (rank 0), the rows' token embeddings (FP16) and, at the PLE layer, its n-gram key and value rows (FP16): the per-sequence inputs of the end-to-end tuning tool (volta_e2e)" )
DEBUG_OPTION( std::string, router_dump, "", "Flash-Next: file that receives, for every MoE layer of every eager prefill chunk (rank 0), each row's 16 largest router logits (expert ids int16, logits FP16) and the log-sum-exp of all its logits (FP32): a compact teacher of the routing (volta_e2e --router-teacher)" )
DEBUG_OPTION( int, route_dump_from, 0, "Flash-Next: route_dump records only the layers from this index on (48 = the MTP head's block only: with calibration replays through the head, a small file instead of every layer)" )
DEBUG_OPTION( std::string, qsa_dump, "", "Flash-Next: file that receives, for every attention layer of every eager prefill chunk that takes the QSA selection (rank 0), each row's selected key pools as bits (rows within the budget: none), to compare two checkpoints' selections offline" )
DEBUG_OPTION( std::string, route_replay, "", "GLM: a <trace_layers>.route file; eager prefill rows found in it use the recorded expert ids and weights (the latest record per layer and position wins), isolating router flips. Flash-Next: a route_dump file of the same text and chunking, its records replayed in order per layer (every rank)" )
DEBUG_OPTION( std::string, qsa_replay, "", "Flash-Next: a qsa_dump file of the same text and chunking; each attention layer's eager prefill chunks past the QSA budget use the recorded pool selections in order, isolating selection flips" )
DEBUG_OPTION( bool, gr_fuse, true, "qwen4_exp: decode-sized rows reduce the sublayer output, add it to the streams and norm them for the next site in one kernel (false = three launches, for A/B)" )
OPTION( bool, mem_log, false, "log the per-pipeline [mem] breakdown at startup (GLM: buffers by kind, weights by kind, drafter; Flash-Next: buffers, weights by kind; DeepSeek-V4.1, every rank: buffers by kind, dense weights by kind, drafter, routed experts and prefill window) and each GPU's free memory outside the arena once loaded; the arena summary lines stay on" )
DEBUG_OPTION( bool, side_streams, true, "GLM, Flash-Next: decode-sized rows run independent chains on side streams (shared expert beside the MoE, KDA / GDN gate projections, MLA / attention projections and the indexer chain); false = one stream, for A/B" )
DEBUG_OPTION( bool, kda_rows, true, "GLM: prefill chunks compute the linear-attention gate projections (project_kda stage 1 and 2) eight rows to a block, so each weight row is read once per eight rows instead of once per row (bit-identical; false = one row per block, A/B)" )
DEBUG_OPTION( bool, hc_rows, true, "GLM: prefill chunks compute the hyper-connection mix four rows to a block, so the mixing matrix is read once per four rows instead of once per row (bit-identical; false = one row per block, A/B)" )
DEBUG_OPTION( bool, hc_fuse, true, "GLM and DeepSeek-V4.1: decode-sized rows reduce the attention or FFN output and apply the hyper-connection post-step in one kernel (false = all-reduce and update as two launches, for A/B)" )
DEBUG_OPTION( bool, normed_add_fuse, true, "Gemma 4: each sublayer output's all-reduce carries the sandwich-norm residual add and the next sublayer's norm in one kernel (false = all-reduce, add and norm as three launches, for A/B)" )
DEBUG_OPTION( bool, dflash_graph, true, "DFlash drafters: the block stage of a draft round (its layers over the anchor and mask rows) replays a CUDA graph per context, the block position and context window read from the device (false = launched kernel by kernel, for A/B)" )
DEBUG_OPTION( bool, mtp_chain, true, "MTP speculation (Flash-Next): the draft steps of a round run back to back on the device, each fed the previous step's argmax, with one host round trip per round (false = a round trip per step, for A/B)" )
DEBUG_OPTION( bool, mtp_graph, true, "MTP speculation (Flash-Next): decode-sized head steps (the chain's one-row steps and the catch-up) replay CUDA graphs instead of launching their kernels one by one (false for A/B)" )
DEBUG_OPTION( bool, qsa_off, false, "qwen4_exp: attend densely past the QSA budget (A/B against the sparse selection)" )
DEBUG_OPTION( bool, router_fp16, false, "qwen4_exp: round the router logits to fp16 before the top-k, as the exllamav3 router stores them" )
DEBUG_OPTION( bool, spec_ctrl_log, false, "speculation controller decisions" )
DEBUG_OPTION( bool, draft_per_slot, true, "DFlash2 on GLM: every slot keeps its own drafter context and tap ring, so several slots speculate; false keeps one context that the newest request takes over (A/B; slot 0 only)" )
DEBUG_OPTION( int, spec_agg_dense, -1, "per-slot speculators with several requests decoding: -1 picks plain batched steps or speculative rounds from their measured rates, 0 always speculates, 1 always steps plainly (A/B)" )
DEBUG_OPTION( std::string, tap_spool, "", "with the DFlash2 drafter: file that receives, when a request finishes, its token list, the drafter taps (5 x hidden FP16 per position) of its last tap_spool_window positions and the target\'s top-16 logits at the positions speculation emitted, for training a drafter adapter offline (record layout in generator.cpp)" )
DEBUG_OPTION( int, tap_spool_window, 768, "with tap_spool: how many of a finished request\'s last positions are written (the tap ring holds 2048)" )
DEBUG_OPTION( std::string, spec_cand_log, "", "DFlash2: file that receives, for every single-slot round, the drafter's 16 merged candidates per position up to the first mismatch with the walk's choice and the target's token, and every finished request's token list (offline re-ranker experiments; see cand_log.h)" )
DEBUG_OPTION( int, spec_joint_max, 2, "DFlash2 joint rounds: most slots verified together; their blocks share one forward of 16 rows, so with more than 2 the longest blocks are cut to fit (spec_depth shortens them first)" )
DEBUG_OPTION( int, spec_joint, -1, "per-slot speculators: one verify forward for the blocks of the speculating slots (MTP: one draft chain too; DFlash2: the blocks are drafted in turn and verified together); 1 on, 0 one slot per round, -1 the speculator's default (DFlash2 on, MTP off)" )
DEBUG_OPTION( bool, spec_interleave, true, "speculators with a context per slot (MTP): interleave one slot's round per step; false steps all active slots plainly together while more than one decodes (A/B)" )
DEBUG_OPTION( bool, no_graphs, false, "eager execution, no CUDA graphs" )
DEBUG_OPTION( bool, vulkan_profile, false, "Vulkan: every dispatch timed on the GPU (a timestamp before it and after its barrier), the totals per kernel printed at exit; eager forwards only (with no_graphs)" )
DEBUG_OPTION( bool, vk_cuda_launch, true, "Vulkan on NVIDIA GPUs with VK_NV_cuda_kernel_launch: the FP16 GEMMs, the NVFP4 linears and the attention (prefill chunks, decode rows on quantized caches) run tensor-core CUDA kernels launched from the command buffers (Volta has no cooperative matrices); false keeps them on the shader cores (A/B)" )
DEBUG_OPTION( bool, vulkan_attn_ref, false, "Vulkan: attention on the portable reference kernel (ref_attn_decode, a workgroup per head and row) instead of the tiled one (fa_attn) (A/B)" )
DEBUG_OPTION( std::string, dump_requests, "", "directory: write every API request body and rendered prompt there, and at its end the prompt and generated token ids (req_N.tokens: int32 prompt length, int32 count, the ids)" )
DEBUG_OPTION( int, dflash_tap_shift, 0, "DFlash v1 drafters (Gemma 4): tap i is the output of target layer target_layer_ids[i] + this (A/B)" )
DEBUG_OPTION( bool, dflash_embed_scale, true, "DFlash v1 drafters: the block's embedding rows carry the target's embedding scale (Gemma 4: sqrt(hidden)); false = the raw table rows (A/B)" )
DEBUG_OPTION( bool, dflash_sliding_causal, true, "DFlash v1 drafters: the block is causal on the sliding-window layers and bidirectional on the full-attention ones; false = bidirectional on every layer (A/B)" )
DEBUG_OPTION( int, dump_draft_round, -1, "speculation round whose drafter inputs are written to /tmp/draft_dump.bin; <0 = off" )
