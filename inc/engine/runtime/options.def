// Runtime and model options: the single source for the Options struct, the ENGINE_<NAME> environment overrides, the launch
// config "options" object / --set key=value, and docs/CONFIG.md (generated by `volta_server --print-config-docs`).
// OPTION( type, name, default, help )         environment variable ENGINE_<NAME>
// DEBUG_OPTION( type, name, default, help )   environment variable ENGINE_DEBUG_<NAME>
// <0 (or 0 for sizes) means "unset: use the model's default" where a help text says so.

OPTION( std::string, log_level, "info", "log threshold: error, warn, info or debug" )
OPTION( int, tp, -1, "rank count: 1, 2 or 4 (GLM: 1, 2 or 4; the CPU build runs one rank, the Vulkan build one device per rank); <0 uses the launch's tp_size" )
OPTION( int, arena_gib, -1, "per-GPU arena in GiB; <=0 sizes it from the device's free memory minus vram_reserve_mib" )
OPTION( int, vram_reserve_mib, -1, "memory left outside the arena for graphs, workspaces and the CUDA context; <0 uses the model's default (Qwen 1536, GLM 288)" )
OPTION( int, max_seq, 0, "context window per slot in tokens (sizes the KV pool); 0 = the model default (Qwen 32768, GLM 12288)" )
OPTION( int, max_slots, 0, "decode slots; 0 = the model default (Qwen 8, GLM 1)" )
OPTION( int, prefix_cache_gib, 16, "pinned host RAM for the prefix cache (sequence snapshots); 0 = off" )
OPTION( int, prefill_chunk, 256, "prompt tokens a new request prefills per scheduler step while other requests are decoding (decode steps run between the pieces); 0 = the whole prompt at once" )
OPTION( int, prefix_interval, 16384, "prompt tokens between automatic prefix checkpoints inside long prompts; 0 = only the requested ones" )
OPTION( std::string, nvfp4_experts, "", "Flash-Next: directory of a modelopt NVFP4 checkpoint (same architecture) to load the routed experts from; everything else comes from the model directory. Empty = the model's own experts" )
OPTION( std::string, nvfp4_dense, "", "dense projection groups to quantize to NVFP4 at load (round-to-nearest from the BF16 tensors of the nvfp4_experts checkpoint): Flash-Next: gdn, shared (or shared_gate / shared_up / shared_down), attn, idx, head; GLM: kda, mla, idx, shared, dense, head; Qwen NVFP4 checkpoint: head (a quarter of the bytes of the FP16 head); or all" )
OPTION( std::string, hessian_dir, "", "Flash-Next calibration: directory to write the input Hessians (x^T x per dense projection input, fp32) of the prefill rows that ran, one file per site at shutdown; empty = off" )
OPTION( bool, mtp_nvfp4, false, "Flash-Next: load the MTP head from the nvfp4_experts checkpoint instead of the model directory (its FP8 block-scaled experts and BF16 dense tensors are quantized to NVFP4 at load; the head then matches the base model, not the model directory's conversion)" )
OPTION( std::string, nvfp4_dense_dir, "", "Flash-Next: directory of calibrated NVFP4 dense tensors (tests/tools/nvfp4_ldlq.py) used instead of round-to-nearest for the groups of nvfp4_dense they cover" )
OPTION( std::string, nvfp4_dense_src, "", "directory of a modelopt NVFP4 checkpoint of the model whose BF16 dense tensors the nvfp4_dense groups are quantized from (GLM; Flash-Next takes them from nvfp4_experts)" )
OPTION( std::string, hessian_layers, "", "with hessian_dir: layers to collect, \"lo-hi\" (GLM: the accumulators of all 45 layers do not fit beside the weights, so collect a third at a time); empty = all" )
OPTION( std::string, kv_format, "", "KV cache format: fp16, fp8, k8v4 or nvfp4; empty = the model default (fp16). GLM stores its single latent tensor in one format (k8v4 = 8-bit)" )
OPTION( double, expert_cache, 1.0, "resident routed-expert fraction in (0, 1] (GLM, Flash-Next); below 1 enables the two-tier expert cache: the codes of the cold experts live in pinned host memory and are read over PCIe" )
OPTION( int, expert_adapt_every, 64, "decode steps between expert residency rebalances (0 = never)" )
OPTION( int, expert_swaps, -1, "maximum expert swaps per rebalance; <0 = the tier default" )
OPTION( std::string, speculator, "dflash", "speculation source: dflash (needs a draft model) or mtp (the checkpoint's own multi-token-prediction head, Qwen)" )
OPTION( int, mtp_depth, 7, "most draft tokens per round with speculator=mtp (1 to 7); the head stops chaining earlier when its recent accuracy is low" )
OPTION( bool, draft_tp, true, "false runs the drafter on rank 0 only" )
OPTION( bool, dsa, true, "GLM sparse attention indexer (top-2048 key selection); false attends densely" )
OPTION( int, max_image_tokens, 1024, "largest image the vision tower accepts, in language-model tokens (4 patches each; sizes its scratch and caps the resize); 0 = image input off" )
OPTION( bool, expert_stats, true, "count the routes per expert for the monitor page (a device sync per rank about once a second while serving)" )
OPTION( bool, spec_ctrl, true, "adaptive speculation controller; false always speculates" )
DEBUG_OPTION( bool, expert_log, false, "per-rebalance expert tier statistics" )
DEBUG_OPTION( int, glm_logit_rows, 0, "GLM: rows of logits a forward can keep; <= 0 = one decode batch (16). Scoring tools (test_ppl) that read the logits of every row of a prefill chunk need the chunk size here (rows x vocabulary x 2 bytes, twice)" )
DEBUG_OPTION( bool, expert_stream, false, "for checkpoints larger than host RAM (needs expert_cache < 1, one rank, GLM): the cold experts live in the checkpoint and are read (parallel pread, NVMe speed) into one pinned layer-sized buffer before each layer's MoE, then read in place as usual; eager forwards only (no graphs), prefill speed is the disk's" )
DEBUG_OPTION( int, expert_synth, 0, "timing only, outputs are wrong. 1: the cold experts of the expert tier alias the device slots of resident ones (no host memory, no PCIe reads, no rebalancing), to time the kernels apart from the link. 2: also no expert tensor is read from the checkpoint (a copy made without them works): the resident slots are generated, with expert_cache < 1 (trellis experts, one rank)" )
DEBUG_OPTION( bool, dsa_diag, false, "sparse-attention indexer diagnostics" )
DEBUG_OPTION( std::string, trace_layers, "", "GLM: file that receives the last row's residual streams after every layer of every eager forward (rank 0)" )
DEBUG_OPTION( double, perturb_embed, 0.0, "GLM: multiply every prompt embedding element by 1 + eps * u (u in [-1, 1], hashed from position and dimension, so independent of chunking); eager prefill only, a noise-floor probe" )
DEBUG_OPTION( std::string, route_replay, "", "GLM: a <trace_layers>.route file; eager prefill rows found in it use the recorded expert ids and weights (the latest record per layer and position wins), isolating router flips" )
DEBUG_OPTION( int, qwen4_halt, -1, "qwen4_exp bring-up: stop the layer stack after this many sublayer sites (0 = after layer 0's attention half, 1 = after its MLP half, ...); <0 runs everything" )
DEBUG_OPTION( bool, gr_fuse, true, "qwen4_exp: decode-sized rows reduce the sublayer output, add it to the streams and norm them for the next site in one kernel (false = three launches, for A/B)" )
DEBUG_OPTION( bool, qsa_off, false, "qwen4_exp: attend densely past the QSA budget (A/B against the sparse selection)" )
DEBUG_OPTION( std::string, teacher_streams, "", "qwen4_exp: file of reference residual streams per layer input (int rows header, then [47][rows][4][hidden] fp32): every layer from 1 on starts from the reference's streams, isolating the per-layer error" )
DEBUG_OPTION( bool, router_fp16, false, "qwen4_exp: round the router logits to fp16 before the top-k, as the exllamav3 router stores them" )
DEBUG_OPTION( double, perturb_layers, 0.0, "qwen4_exp: multiply the residual streams after every layer by 1 + eps * u (u hashed from position, stream, dim and layer): a model of per-layer rounding noise; eager prefill only" )
DEBUG_OPTION( bool, spec_ctrl_log, false, "speculation controller decisions" )
DEBUG_OPTION( bool, spec_joint, false, "per-slot speculators (MTP): one draft chain and one verify forward for the blocks of all speculating slots (measured: no gain over one slot per round at 2 requests, up to ~+6-25% at 4; outputs then differ from a lone request); false runs one slot per round" )
DEBUG_OPTION( bool, spec_interleave, true, "speculators with a context per slot (MTP): interleave one slot's round per step; false steps all active slots plainly together while more than one decodes (A/B)" )
DEBUG_OPTION( bool, no_graphs, false, "eager execution, no CUDA graphs" )
DEBUG_OPTION( std::string, dump_requests, "", "directory: write every API request body and rendered prompt there" )
DEBUG_OPTION( int, dump_draft_round, -1, "speculation round whose drafter inputs are written to /tmp/draft_dump.bin; <0 = off" )
