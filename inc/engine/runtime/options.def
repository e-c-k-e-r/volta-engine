// Runtime and model options: the single source for the Options struct, the ENGINE_<NAME> environment overrides, the launch
// config "options" object / --set key=value, and docs/CONFIG.md (generated by `volta_server --print-config-docs`).
// OPTION( type, name, default, help )         environment variable ENGINE_<NAME>
// DEBUG_OPTION( type, name, default, help )   environment variable ENGINE_DEBUG_<NAME>
// <0 (or 0 for sizes) means "unset: use the model's default" where a help text says so.

OPTION( std::string, log_level, "info", "log threshold: error, warn, info or debug" )
OPTION( int, tp, -1, "rank count: 1, 2 or 4 (GLM: 1, 2 or 4; the CPU build runs one rank, the Vulkan build one device per rank); <0 uses the launch's tp_size" )
OPTION( int, arena_gib, -1, "per-GPU arena in GiB; <=0 sizes it from the device's free memory minus vram_reserve_mib" )
OPTION( int, vram_reserve_mib, -1, "memory left outside the arena for graphs, workspaces and the CUDA context; <0 uses the model's default (Qwen 1536, GLM 288)" )
OPTION( int, max_seq, 0, "context window per slot in tokens (sizes the KV pool); 0 = the model default (Qwen 32768, GLM 12288)" )
OPTION( int, max_slots, 0, "decode slots; 0 = the model default (Qwen 8, GLM 1)" )
OPTION( int, prefix_cache_gib, 16, "pinned host RAM for the prefix cache (sequence snapshots); 0 = off" )
OPTION( int, prefill_window, 0, "GLM (up to 8), DeepSeek (up to 16): prefill several chunks of a prompt layer by layer: the routed experts of a layer then run once over all the window's rows instead of once per 512-row chunk, which they do faster per row; costs about 0.1 GiB of buffers per extra chunk (the KV pool or expert_cache give it back); 0 or 1 = a chunk at a time" )
OPTION( double, prefill_budget_ms, 0.0, "while other requests are decoding, the longest (ms) a prompt piece may run before the decoding requests step again: the piece size adapts between 64 and prefill_chunk rows from the measured piece time (a 512-row GLM piece takes about 610 ms, 256 rows 370, 128 rows 270; smaller pieces lower the prompt's speed); 0 = pieces of prefill_chunk rows" )
OPTION( int, prefill_cooldown, 0, "while other requests are decoding, the decode steps that run between two prompt pieces (0 = a piece every step): the decoding requests then get most of the GPU time and the prompt is ingested more slowly, in pieces of the same size" )
OPTION( int, prefill_chunk, 512, "prompt tokens a new request prefills per scheduler step while other requests are decoding (decode steps run between the pieces); 0 = the whole prompt at once" )
OPTION( int, prefix_interval, 16384, "prompt tokens between automatic prefix checkpoints inside long prompts; 0 = only the requested ones" )
OPTION( std::string, nvfp4_experts, "", "Flash-Next: directory of a modelopt NVFP4 checkpoint (same architecture) to load the routed experts from; everything else comes from the model directory. Empty = the model's own experts" )
OPTION( std::string, nvfp4_dense, "", "dense projection groups to quantize to NVFP4 at load (round-to-nearest from the BF16 tensors of the nvfp4_experts checkpoint): Flash-Next: gdn, shared (or shared_gate / shared_up / shared_down), attn, idx, head; GLM: kda, mla, idx, shared, dense, head; Qwen NVFP4 checkpoint: head (a quarter of the bytes of the FP16 head); or all" )
OPTION( std::string, hessian_dir, "", "calibration (Flash-Next, GLM): directory to write the input Hessians (x^T x per dense projection input, fp32) of the prefill rows that ran, one file per site at shutdown; empty = off" )
OPTION( bool, mtp_nvfp4, false, "Flash-Next: load the MTP head from the nvfp4_experts checkpoint instead of the model directory (its FP8 block-scaled experts and BF16 dense tensors are quantized to NVFP4 at load; the head then matches the base model, not the model directory's conversion)" )
OPTION( std::string, nvfp4_dense_dir, "", "Flash-Next, GLM: directory of calibrated NVFP4 dense tensors (tests/tools/nvfp4_ldlq.py) used instead of round-to-nearest for the groups of nvfp4_dense they cover" )
OPTION( std::string, nvfp4_dense_src, "", "directory of a modelopt NVFP4 checkpoint of the model whose BF16 dense tensors the nvfp4_dense groups are quantized from (GLM; Flash-Next takes them from nvfp4_experts)" )
OPTION( std::string, hessian_layers, "", "with hessian_dir: layers to collect, \"lo-hi\" (GLM: the accumulators of all 45 layers do not fit beside the weights, so collect a third at a time); empty = all" )
OPTION( std::string, kv_format, "", "KV cache format: fp16, fp8, k8v4 or nvfp4; empty = the model default (fp16). GLM stores its single latent tensor in one format (k8v4 = 8-bit)" )
OPTION( int, kv_pool, 0, "GLM: tokens of one shared KV pool for all slots (latent cache and indexer keys, in pages of 512 tokens); 0 = every slot owns max_seq tokens. With 2 slots of 256K, 262144 holds one long and one short conversation, or two of 128K, in half the memory; a request is admitted when the pool has room for its prompt and ends with finish reason length when the pool runs out" )
OPTION( double, expert_cache, 1.0, "resident routed-expert fraction in (0, 1] (GLM, Flash-Next), or auto (GLM only): the largest fraction the arena holds after the other weights, the speculator and a 0.25 GiB margin (the log prints the plan); below 1 enables the two-tier expert cache: the codes of the cold experts live in pinned host memory and are read over PCIe" )
OPTION( int, expert_stage, -1, "expert tier, prefill chunks: copy a layer's cold experts once into device scratch, a layer ahead of the compute, instead of reading them over PCIe from every row tile (needs 2 x the cold experts of a layer in the arena; off when it does not fit). -1 auto: on, except for Flash-Next's trellis experts (measured with 2.05 bpw experts, half of them resident, on 3000 real tokens: staging was 15-25% slower at 256 rows and level at 512); 0 off; 1 on" )
OPTION( int, expert_adapt_every, 64, "decode steps between expert residency rebalances (0 = never)" )
OPTION( int, expert_swap_margin, 2, "a cold expert replaces the coldest resident one only when its decayed route score exceeds 1.5 x the resident one's plus this margin (scores are route counts per rebalance window, folded as score / 2 + count); lower values adapt faster and flip more" )
OPTION( int, expert_history_pct, 75, "the largest share (percent) of a swap decision taken from a layer's long-run route counts (saved between runs with expert_heat_file) instead of the last windows; it grows with the amount of history, so a cold start follows the first windows; 0 = windows only" )
OPTION( int, expert_swaps, -1, "maximum expert swaps per layer per rebalance; <0 = derived from expert_swap_mib" )
OPTION( int, expert_swap_mib, 1024, "bytes the swaps of one rebalance pass may move (MiB; a swap moves two experts), spread over the layers, when expert_swaps is not set" )
OPTION( bool, expert_shard, false, "DeepSeek on several GPUs: every rank holds a slice (a share of the intermediate width, in 128-wide spans, the larger shares rotating with the expert) of every routed expert instead of whole experts dealt to the ranks. The ranks then wait for each other 6% of the time instead of 40%, but each runs all six experts of a token as narrow slices and the expert kernel costs per expert, so decode is about 7% slower and prefill about equal" )
OPTION( std::string, expert_heat_file, "", "file the tiered experts' per-layer route counts are saved to (every few rebalances and at exit) and read from at start: the resident sets then start with the hottest experts instead of experts 0..N-1 (one file per rank: .r<rank> is appended with more than one rank). DeepSeek-V4.1: counts saved at exit; at start the experts are dealt to the ranks by heat and the hottest stay on the device" )
OPTION( double, cpu_experts, 0.0, "with expert_cache < 1 (GLM, Flash-Next): decode hands this share (0 to 1, rounded down) of a layer's distinct cold experts to the host CPU while the GPU reads the rest over PCIe, so the two work at the same time; a lone cold expert stays on PCIe. NVFP4 experts are read in place from the pinned copy the GPU uses (plus a copy of their scales, 1/8 of the codes); EXL3 experts get a second, repacked copy in host RAM and the CPU does not beat PCIe on them in single-row decode. 0.5 measured +26% on Flash-Next NVFP4 at expert_cache 0.4" )
OPTION( std::string, cpu_expert_cpus, "", "with cpu_experts: the logical CPUs of the expert threads, e.g. 10-19 (the first runs the dispatcher and takes part in the work; all are pinned); keep clear of the cores 0 to 3 that drive the GPUs (one per rank); empty = 4 unpinned threads" )
OPTION( int, cpu_expert_node, -1, "with cpu_experts: NUMA node the CPU-side copies (NVFP4 scales, repacked EXL3 codes) are bound to; the cold experts' pinned codes sit on the node of the rank threads (node 0). <0 = not bound" )
OPTION( int, cpu_expert_spin_us, 2000, "with cpu_experts: microseconds the expert threads keep polling for work after the last request before they sleep; a sleeping core costs a wake-up and a clock ramp (up to a few hundred microseconds) on the next layer that needs it, polling keeps the cores busy (hotter, louder)" )
OPTION( std::string, speculator, "dflash", "speculation source: dflash (needs a draft model), mtp (the checkpoint's own multi-token-prediction head: Qwen, Flash-Next, GLM), suffix (no model: the text that followed the last earlier occurrence of the request's current suffix, spec_suffix > 0; DeepSeek) or dspark (DeepSeek: the block drafter in draft_model_dir, see dspark_conf)" )
DEBUG_OPTION( bool, dflash_attn_scalar, false, "DFlash2 drafter attention on CUDA: the scalar one-block-per-(row, head) kernel instead of the split-key kernel (for A/B)" )
DEBUG_OPTION( bool, spec_profile, false, "DFlash2: time the stages of every round (draft, walk, snapshot switch, verify launch, sample wait, accept) and log the per-round averages when the server shuts down" )
DEBUG_OPTION( bool, merge_expert_groups, true, "DeepSeek-V4.1 packs whose experts have different widths per projection: one MoE launch per layer over all of a rank's experts with a width table (false: one launch per width combination, for A/B)" )
DEBUG_OPTION( bool, fp8_resident, true, "DeepSeek-V4.1 packs that keep the original FP8 attention and shared-expert weights (SAGE): keep them FP8 in device memory (false: dequantize to FP16 at load, twice the bytes)" )
DEBUG_OPTION( bool, indexer_tc, true, "DeepSeek-V4.1: the indexer scores prefill rows on tensor cores (false: the scalar kernel, for A/B)" )
OPTION( double, dspark_conf, 0.5, "speculator=dspark: a draft token is verified only while the drafter's confidence head scores it and every earlier token of the block at least this (0 = always the whole block)" )
OPTION( int, mtp_depth, 7, "most draft tokens per round with speculator=mtp (1 to 7); the head stops chaining earlier when its recent accuracy is low" )
OPTION( bool, draft_tp, true, "false runs the drafter on rank 0 only" )
OPTION( bool, dsa, true, "GLM sparse attention indexer (top-2048 key selection); false attends densely" )
OPTION( int, max_image_tokens, 1024, "largest image the vision tower accepts, in language-model tokens (4 patches each, 9 for DeepSeek, whose count also includes the span's delimiter and newline tokens; sizes its scratch and caps the resize); 0 = image input off. DeepSeek keeps the tower's 0.9 GiB plus scratch out of rank 0's resident experts (rank 0 57% -> 54% at 576, decode +2.5%, a 4-row verify +5%, prefill -5 to -10%): its shipped config sets 576, the gate and the benchmarks pass 0" )
OPTION( bool, expert_stats, true, "count the routes per expert for the monitor page (a device sync per rank about once a second while serving)" )
OPTION( double, spec_depth, 0.0, "DFlash2: shorten each round's block where the drafter's recent per-position accuracy says the chance of reaching a position is below this (0 = always the whole block; 0.15 to 0.3 measured +3 to +5% on GLM)" )
OPTION( int, spec_suffix_min, 3, "with spec_suffix: the fewest continuation tokens a match must offer to be used instead of drafting (1 to 7)" )
OPTION( int, spec_suffix, 0, "DFlash2, speculator=suffix: propose the tokens that followed the last earlier occurrence of the current suffix of this request's prompt and output (copied text: file contents, tool arguments, identifiers) instead of drafting when that suffix matches at least this many tokens; 0 = always draft" )
OPTION( bool, spec_ctrl, true, "adaptive speculation controller; false always speculates" )
DEBUG_OPTION( bool, moe_prefill_tile, true, "trellis MoE, prefill chunks of more than 128 rows: the 32-row expert tile with two resident blocks per SM; false runs the 16-row tile of the decode kernels (A/B)" )
DEBUG_OPTION( bool, shared_slice, true, "GLM: the shared expert is cut over the ranks (each holds and runs 1/tp of its width, the partial outputs meet in the MoE all-reduce) and so is the dense MLP of layers 0-2 (an all-reduce after its down projection); false loads the shared expert whole on every rank, run on rank 0, and the dense MLP whole on every rank (A/B)" )
DEBUG_OPTION( bool, moe_gemv, false, "ROCm: the expert-grouped EXL3 MoE runs its projections on the v_dot2 GEMV instead of the WMMA kernels" )
DEBUG_OPTION( bool, nvfp4_hipblas, false, "ROCm: NVFP4 linears of more than 16 rows dequantize into FP16 and run one hipBLAS GEMM instead of the fused WMMA GEMM (the FP16 scratch can move as it grows, which a captured graph cannot follow)" )
DEBUG_OPTION( bool, expert_log, false, "per-rebalance expert tier statistics" )
DEBUG_OPTION( int, glm_logit_rows, 0, "GLM: rows of logits a forward can keep; <= 0 = one decode batch (16). Scoring tools (test_ppl) that read the logits of every row of a prefill chunk need the chunk size here (rows x vocabulary x 2 bytes, twice)" )
DEBUG_OPTION( bool, expert_stream, false, "for checkpoints larger than host RAM (needs expert_cache < 1, one rank, GLM): the cold experts live in the checkpoint and are read (parallel pread, NVMe speed) into one pinned layer-sized buffer before each layer's MoE, then read in place as usual; eager forwards only (no graphs), prefill speed is the disk's" )
DEBUG_OPTION( int, expert_synth, 0, "timing only, outputs are wrong. 1: the cold experts of the expert tier alias the device slots of resident ones (no host memory, no PCIe reads, no rebalancing), to time the kernels apart from the link. 2: also no expert tensor is read from the checkpoint (a copy made without them works): the resident slots are generated, with expert_cache < 1 (trellis experts, one rank)" )
DEBUG_OPTION( bool, dsa_diag, false, "sparse-attention indexer diagnostics" )
DEBUG_OPTION( std::string, trace_layers, "", "GLM, Flash-Next: file that receives the last row's residual streams after every layer of every eager forward (rank 0)" )
DEBUG_OPTION( double, perturb_embed, 0.0, "GLM, Flash-Next: multiply every prompt embedding element by 1 + eps * u (u in [-1, 1], hashed from position and dimension, so independent of chunking); eager prefill only, a noise-floor probe" )
DEBUG_OPTION( std::string, route_dump, "", "Flash-Next, GLM: file that receives, for every MoE layer of every eager prefill chunk (rank 0), the router input rows (FP16) and the routed expert ids, to measure how well a layer's routing can be predicted from the layer before it (offline)" )
DEBUG_OPTION( std::string, route_replay, "", "GLM: a <trace_layers>.route file; eager prefill rows found in it use the recorded expert ids and weights (the latest record per layer and position wins), isolating router flips" )
DEBUG_OPTION( int, qwen4_halt, -1, "qwen4_exp bring-up: stop the layer stack after this many sublayer sites (0 = after layer 0's attention half, 1 = after its MLP half, ...); <0 runs everything" )
DEBUG_OPTION( bool, gr_fuse, true, "qwen4_exp: decode-sized rows reduce the sublayer output, add it to the streams and norm them for the next site in one kernel (false = three launches, for A/B)" )
OPTION( bool, mem_log, false, "log the per-pipeline [mem] breakdown at startup (GLM: buffers by kind, weights by kind, drafter; Flash-Next: buffers, weights by kind); the arena summary lines stay on" )
DEBUG_OPTION( bool, side_streams, true, "GLM, Flash-Next: decode-sized rows run independent chains on side streams (shared expert beside the MoE, KDA / GDN gate projections, MLA / attention projections and the indexer chain); false = one stream, for A/B" )
DEBUG_OPTION( bool, kda_rows, true, "GLM: prefill chunks compute the linear-attention gate projections (project_kda stage 1 and 2) eight rows to a block, so each weight row is read once per eight rows instead of once per row (bit-identical; false = one row per block, A/B)" )
DEBUG_OPTION( bool, hc_rows, true, "GLM: prefill chunks compute the hyper-connection mix four rows to a block, so the mixing matrix is read once per four rows instead of once per row (bit-identical; false = one row per block, A/B)" )
DEBUG_OPTION( bool, hc_fuse, true, "GLM: decode-sized rows reduce the attention or FFN output and apply the hyper-connection post-step in one kernel (false = all-reduce and update as two launches, for A/B)" )
DEBUG_OPTION( bool, qsa_off, false, "qwen4_exp: attend densely past the QSA budget (A/B against the sparse selection)" )
DEBUG_OPTION( std::string, teacher_streams, "", "qwen4_exp: file of reference residual streams per layer input (int rows header, then [47][rows][4][hidden] fp32): every layer from 1 on starts from the reference's streams, isolating the per-layer error" )
DEBUG_OPTION( bool, router_fp16, false, "qwen4_exp: round the router logits to fp16 before the top-k, as the exllamav3 router stores them" )
DEBUG_OPTION( double, perturb_layers, 0.0, "qwen4_exp: multiply the residual streams after every layer by 1 + eps * u (u hashed from position, stream, dim and layer): a model of per-layer rounding noise; eager prefill only" )
DEBUG_OPTION( bool, spec_ctrl_log, false, "speculation controller decisions" )
DEBUG_OPTION( bool, draft_per_slot, true, "DFlash2 on GLM: every slot keeps its own drafter context and tap ring, so several slots speculate; false keeps one context that the newest request takes over (A/B; slot 0 only)" )
DEBUG_OPTION( int, spec_agg_dense, -1, "per-slot speculators with several requests decoding: -1 picks plain batched steps or speculative rounds from their measured rates, 0 always speculates, 1 always steps plainly (A/B)" )
DEBUG_OPTION( std::string, tap_spool, "", "GLM with the DFlash2 drafter: file that receives, when a request finishes, its token list and the drafter taps (5 x hidden FP16 per position) of its last tap_spool_window positions, for training a drafter adapter offline (record layout in generator.cpp)" )
DEBUG_OPTION( int, tap_spool_window, 768, "with tap_spool: how many of a finished request\'s last positions are written (the tap ring holds 2048)" )
DEBUG_OPTION( std::string, spec_cand_log, "", "DFlash2: file that receives, for every single-slot round, the drafter's 16 merged candidates per position up to the first mismatch with the walk's choice and the target's token, and every finished request's token list (offline re-ranker experiments; see cand_log.h)" )
DEBUG_OPTION( int, spec_joint_max, 2, "DFlash2 joint rounds: most slots verified together; their blocks share one forward of 16 rows, so with more than 2 the longest blocks are cut to fit (spec_depth shortens them first)" )
DEBUG_OPTION( int, spec_joint, -1, "per-slot speculators: one verify forward for the blocks of the speculating slots (MTP: one draft chain too; measured no gain over one slot per round at 2 requests, up to ~+6-25% at 4; DFlash2: the blocks are drafted in turn and verified together); 1 on, 0 one slot per round, -1 the speculator's default (DFlash2 on, MTP off)" )
DEBUG_OPTION( bool, spec_interleave, true, "speculators with a context per slot (MTP): interleave one slot's round per step; false steps all active slots plainly together while more than one decodes (A/B)" )
DEBUG_OPTION( bool, no_graphs, false, "eager execution, no CUDA graphs" )
DEBUG_OPTION( std::string, dump_requests, "", "directory: write every API request body and rendered prompt there" )
DEBUG_OPTION( int, dump_draft_round, -1, "speculation round whose drafter inputs are written to /tmp/draft_dump.bin; <0 = off" )
