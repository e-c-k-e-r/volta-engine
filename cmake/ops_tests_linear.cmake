# ops_tests_linear: op-level golden test targets for one Wave 3 lane (built in the CUDA configuration for --dump and in the CPU configuration for --check)
# test_ops_linear / test_ops_moe: one source each, `--dump <dir>` (CUDA build) and `--check <dir>` (any build)
if(ENGINE_BACKEND STREQUAL "CPU")
	# The CPU linear (src/backend/cpu/linear_trellis.cpp) runs on the E1 reference Slang kernels: build their host-target sources
	# into the existing Slang object library so every CPU executable links them
	if(DEFINED REF_LIN_CPU_SOURCES AND TARGET engine_cpu_slang)
		set_source_files_properties(${REF_LIN_CPU_SOURCES} PROPERTIES GENERATED TRUE)
		target_sources(engine_cpu_slang PRIVATE ${REF_LIN_CPU_SOURCES})
		add_dependencies(engine_cpu_slang ref_lin_slang)
	endif()
	foreach(t test_ops_linear test_ops_moe)
		add_executable(${t} tests/2_parity/${t}.cpp ${ENGINE_CPU_OBJECTS})
		target_link_libraries(${t} PRIVATE pthread)
		set_target_properties(${t} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}")
	endforeach()
elseif(ENGINE_BACKEND STREQUAL "CUDA")
	foreach(t test_ops_linear test_ops_moe)
		add_executable(${t} tests/2_parity/${t}.cpp)
		target_link_libraries(${t} PRIVATE engine_kernels)
		set_target_properties(${t} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}")
	endforeach()
endif()
